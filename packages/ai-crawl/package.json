{
  "name": "@metricpanel/ai-crawl",
  "version": "1.0.0-rc.3",
  "description": "Server-side AI crawler tracking for MetricPanel",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist tsconfig.build.tsbuildinfo",
    "build": "bun run clean && bun run build:esm && bun run build:cjs && bun run build:types",
    "build:esm": "bun build ./src/index.ts --outdir ./dist --format esm --target node --entry-naming='index.mjs' --sourcemap=external",
    "build:cjs": "bun build ./src/index.ts --outdir ./dist --format cjs --target node --entry-naming='index.cjs' --sourcemap=external",
    "build:types": "tsc -p tsconfig.build.json && bun scripts/finalize-types.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:check": "eslint src scripts --max-warnings=0",
    "format:check": "prettier --check .",
    "package:check": "publint && bun scripts/check-package.ts",
    "check": "bun run lint:check && bun run test && bun run typecheck && bun run format:check && bun run build && bun run package:check"
  },
  "author": {
    "name": "FiftyOne Digital",
    "url": "https://fiftyone.dev"
  },
  "homepage": "https://docs.metricpanel.io/ai-crawlers",
  "bugs": {
    "url": "https://github.com/fiftyone/metricpanel-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fiftyone/metricpanel-js.git",
    "directory": "packages/ai-crawl"
  },
  "keywords": [
    "analytics",
    "ai-crawler",
    "bot",
    "nextjs",
    "cloudflare",
    "metricpanel"
  ],
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18",
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  },
  "packageManager": "bun@1.3.8",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "3.6.2",
    "publint": "0.3.24",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.7"
  }
}
